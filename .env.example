# ===== AI 生图工坊 环境变量模板 =====
# 复制本文件为 backend/.env，填入真实值。backend/.env 不会被 git 提交（见 .gitignore）。

# --- OpenAI 兼容服务（OpenAI / DeepSeek / 通义百炼 / vLLM / Ollama 均适用）---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 本地 llama.cpp server ---
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_API_KEY=
LLAMA_MODEL=llama-3.1-8b
LLAMA_MAX_TOKENS=1024

# --- 默认 LLM provider（openai / llama）---
DEFAULT_LLM_PROVIDER=openai

# --- 安全（生产环境务必覆盖）---
# JWT 签名密钥：生产环境改成一段足够长的随机字符串（如 openssl rand -hex 32 生成）
JWT_SECRET=change-me-in-production-please
# token 有效期（分钟），默认 24 小时
JWT_EXPIRE_MINUTES=1440
# 每用户每日 LLM 调用额度（-1 表示不限）
DAILY_CHAT_QUOTA=100

# --- ComfyUI / 存储 / 队列（一般不用改）---
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# DATABASE_URL=sqlite:///backend/data/aistudio.db
# REDIS_URL=redis://127.0.0.1:6379/0

# --- 素材上传落盘目录（视频生成参考图/视频/音频）---
# 必须指向 ComfyUI 的 input 目录，否则 LoadImage/LoadVideo/LoadAudio 读不到素材。
# 未配置时回退到 backend/data/upload（仅本地调试，ComfyUI 读不到）。
# COMFYUI_INPUT_DIR=D:\AI_MOVIE\ComfyUI_windows_portable\ComfyUI\input
