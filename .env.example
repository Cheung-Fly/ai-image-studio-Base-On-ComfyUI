# ===== AI 生图工坊 环境变量模板 =====
# 本地运行时复制为 backend/.env；Docker Compose 使用时复制为项目根目录 .env。
# .env 文件已被 git 忽略。不要把真实 API Key 写入代码、提交或聊天记录。

# --- OpenAI 兼容服务（也支持 OpenRouter / DeepSeek / 通义百炼 / vLLM / Ollama）---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 本地 llama.cpp server ---
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_API_KEY=
LLAMA_MODEL=llama-3.1-8b
LLAMA_MAX_TOKENS=1024

# --- 默认 LLM provider（openai / llama）---
DEFAULT_LLM_PROVIDER=openai

# --- 加密密钥 ---
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 首次保存加密凭据前必须设置；备份时请单独安全保管，丢失后无法解密已保存的凭据。
ENCRYPTION_KEY=
# 仅在迁移旧版密文时临时设置旧密钥；旧版未显式配置时曾使用公开示例默认值。
# 若旧部署使用了自定义密钥，请填写原值；轮换成功后可移除此项。
LEGACY_ENCRYPTION_KEY=
# 每用户每日 LLM 调用额度（-1 表示不限）
DAILY_CHAT_QUOTA=100

# --- ComfyUI / 存储 / 队列（按需配置）---
# 后端/MCP 连接 ComfyUI API 的地址；Docker Compose 默认使用 host.docker.internal:8188
# COMFYUI_BASE_URL=http://host.docker.internal:8188
# 可选：本机 ComfyUI 的 LoRA 目录；不配置时使用 ./data/loras
# COMFYUI_LORAS_HOST_DIR=D:/AI_MOVIE/ComfyUI_windows_portable/ComfyUI/models/loras
# 浏览器打开 ComfyUI 的默认网页地址（也可在 UI 按浏览器保存覆盖；远程访问时设置为浏览器可达地址）
COMFYUI_WEB_URL=http://127.0.0.1:8188
# DATABASE_URL=sqlite:///backend/data/aistudio.db
# REDIS_URL=redis://127.0.0.1:6379/0

# --- 素材上传落盘目录（视频生成参考图/视频/音频）---
# 必须指向 ComfyUI 的 input 目录，否则 LoadImage/LoadVideo/LoadAudio 读不到素材。
# 未配置时回退到 backend/data/upload（仅本地调试，ComfyUI 读不到）。
# COMFYUI_INPUT_DIR=D:\AI_MOVIE\ComfyUI_windows_portable\ComfyUI\input
